<pre class="diff-section-table-cell diff-section-change">{{#each
    this.diffChunks
    as |chunk|
  }}<span
      class="diff-line
        {{if chunk.added 'diff-line-added'}}
        {{if chunk.removed 'diff-line-removed'}}"
    >{{chunk.value}}</span>{{/each}}</pre>